<div class="validation-summary" role="alert">
    <strong>@Title</strong>
    <p>@Message</p>
    @if (OnRetry.HasDelegate)
    {
        <button type="button" class="btn btn-secondary" @onclick="OnRetry">Reintentar</button>
    }
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "No fue posible cargar la información";

    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnRetry { get; set; }
}
