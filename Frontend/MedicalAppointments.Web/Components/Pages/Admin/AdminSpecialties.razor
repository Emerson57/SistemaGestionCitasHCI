@page "/admin/especialidades"
@attribute [Authorize(Roles = AppRoles.Administrator)]
@rendermode InteractiveServer
@inject ISpecialtyApiService SpecialtyApi

<PageTitle>Especialidades</PageTitle>
<h1 class="page-title">Especialidades</h1>
<p class="page-lead">Administra las especialidades médicas disponibles para agendar citas.</p>

<div class="card" style="margin-bottom: var(--space-lg);">
    <h2 class="section-title">@(_editId is null ? "Crear especialidad" : "Editar especialidad")</h2>
    <div class="form-grid two-col">
        <div class="form-field"><label>Nombre</label><InputText @bind-Value="_name" /></div>
        <div class="form-field"><label>Descripción</label><InputText @bind-Value="_description" /></div>
    </div>
    <div class="hero-actions">
        <button type="button" class="btn btn-primary" @onclick="SaveAsync">@(_editId is null ? "Crear" : "Guardar")</button>
        @if (_editId is not null) { <button type="button" class="btn btn-secondary" @onclick="ResetForm">Cancelar edición</button> }
    </div>
</div>

@if (_loading) { <LoadingIndicator />; }
else if (_items.Count == 0)
{
    <EmptyState Title="Sin especialidades" Description="Crea la primera especialidad para habilitar la agenda." />
}
else
{
    <div class="admin-list">
        @foreach (var item in _items)
        {
            <article class="card admin-list-item">
                <div>
                    <strong>@item.Name</strong>
                    <p class="text-muted">@item.Description</p>
                </div>
                <div class="hero-actions">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Edit(item)">Editar</button>
                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => AskDeactivate(item)">Desactivar</button>
                </div>
            </article>
        }
    </div>
}

<ConfirmDialog @bind-IsOpen="_confirmOpen" Title="Desactivar especialidad"
               Message="La especialidad dejará de estar disponible para nuevas citas. Los registros existentes se conservan."
               ConfirmText="Desactivar" OnConfirmed="DeactivateConfirmedAsync" />

@code {
    private bool _loading = true;
    private List<Models.Specialties.SpecialtyDto> _items = [];
    private int? _editId;
    private string _name = string.Empty;
    private string? _description;
    private bool _confirmOpen;
    private int? _deactivateId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _items = (await SpecialtyApi.GetActiveAsync()).ToList();
        _loading = false;
    }

    private void Edit(Models.Specialties.SpecialtyDto item)
    {
        _editId = item.Id;
        _name = item.Name;
        _description = item.Description;
    }

    private void ResetForm()
    {
        _editId = null;
        _name = string.Empty;
        _description = null;
    }

    private async Task SaveAsync()
    {
        if (_editId is null)
        {
            await SpecialtyApi.CreateAsync(new Models.Specialties.CreateSpecialtyRequest { Name = _name, Description = _description });
        }
        else
        {
            await SpecialtyApi.UpdateAsync(_editId.Value, new Models.Specialties.UpdateSpecialtyRequest { Name = _name, Description = _description });
        }

        ResetForm();
        await LoadAsync();
    }

    private void AskDeactivate(Models.Specialties.SpecialtyDto item)
    {
        _deactivateId = item.Id;
        _confirmOpen = true;
    }

    private async Task DeactivateConfirmedAsync()
    {
        if (_deactivateId is null) return;
        await SpecialtyApi.DeactivateAsync(_deactivateId.Value);
        _deactivateId = null;
        await LoadAsync();
    }
}
