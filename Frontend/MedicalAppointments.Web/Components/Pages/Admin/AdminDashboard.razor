@page "/admin"
@attribute [Authorize(Roles = AppRoles.Administrator)]
@rendermode InteractiveServer

<PageTitle>Administración</PageTitle>
<h1 class="page-title">Panel de administración</h1>
<p class="page-lead">Accesos directos para mantener especialidades, médicos y pacientes.</p>

<div class="grid-cards three">
    <a class="card card-selectable" href="/admin/especialidades" style="text-decoration:none;color:inherit;">
        <h2 class="card-title">Especialidades</h2>
        <p class="text-muted">Gestionar catálogo médico.</p>
    </a>
    <a class="card card-selectable" href="/admin/medicos" style="text-decoration:none;color:inherit;">
        <h2 class="card-title">Médicos</h2>
        <p class="text-muted">Registrar y mantener médicos.</p>
    </a>
    <a class="card card-selectable" href="/admin/pacientes" style="text-decoration:none;color:inherit;">
        <h2 class="card-title">Pacientes</h2>
        <p class="text-muted">Consultar usuarios pacientes.</p>
    </a>
</div>
