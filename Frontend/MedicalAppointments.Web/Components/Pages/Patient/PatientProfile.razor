@page "/paciente/perfil"
@attribute [Authorize(Roles = AppRoles.Patient)]
@rendermode InteractiveServer
@inject IPatientApiService PatientApi
@inject NotificationService Notifications

<PageTitle>Mi perfil</PageTitle>
<h1 class="page-title">Mi perfil</h1>

@if (_loading) { <LoadingIndicator />; }
else
{
    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <div class="form-field"><label>Nombre completo</label><InputText @bind-Value="_model.FullName" /></div>
        <div class="form-field"><label>Fecha de nacimiento</label><InputDate @bind-Value="_birthDate" /></div>
        <div class="form-field"><label>Dirección</label><InputText @bind-Value="_model.Address" /></div>
        <div class="form-field"><label>Teléfono</label><InputText @bind-Value="_model.PhoneNumber" /></div>
        <div class="form-field"><label>Sexo</label><InputSelect @bind-Value="_model.Sex">@foreach (Sex s in Enum.GetValues<Sex>()) { <option value="@s">@DisplayLabels.FormatSex(s)</option> }</InputSelect></div>
        <div class="form-field"><label>Discapacidad</label><InputText @bind-Value="_model.Disability" /></div>
        <div class="form-field"><label>Estado civil</label><InputSelect @bind-Value="_model.MaritalStatus">@foreach (MaritalStatus s in Enum.GetValues<MaritalStatus>()) { <option value="@s">@DisplayLabels.FormatMaritalStatus(s)</option> }</InputSelect></div>
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="validation-summary">@_error</div> }
        <button class="btn btn-primary" type="submit" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar cambios")</button>
    </EditForm>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private DateTime? _birthDate;
    private Models.Patients.UpdatePatientRequest _model = new()
    {
        FullName = string.Empty,
        Address = string.Empty,
        PhoneNumber = string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var me = await PatientApi.GetMeAsync();
            _birthDate = me.BirthDate.ToDateTime(TimeOnly.MinValue);
            _model = new Models.Patients.UpdatePatientRequest
            {
                FullName = me.FullName,
                BirthDate = me.BirthDate,
                Address = me.Address,
                PhoneNumber = me.PhoneNumber,
                Sex = me.Sex,
                Disability = me.Disability,
                MaritalStatus = me.MaritalStatus
            };
        }
        catch (ApiException ex) { _error = ApiErrorTranslator.ToUserMessage(ex); }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        if (_birthDate is null) return;
        _model.BirthDate = DateOnly.FromDateTime(_birthDate.Value);
        _saving = true;
        try
        {
            await PatientApi.UpdateMeAsync(_model);
            Notifications.ShowSuccess("Perfil actualizado correctamente.");
        }
        catch (ApiException ex) { _error = ApiErrorTranslator.ToUserMessage(ex); }
        finally { _saving = false; }
    }
}
