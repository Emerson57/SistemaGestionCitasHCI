@page "/paciente/citas"
@attribute [Authorize(Roles = AppRoles.Patient)]
@rendermode InteractiveServer
@inject IAppointmentApiService AppointmentApi
@inject IAuthSessionReadiness AuthReadiness

<PageTitle>Mis citas</PageTitle>
<h1 class="page-title">Mis citas</h1>
<p class="page-lead">Consulta tus citas activas. Puedes reprogramar o cancelar según las reglas del sistema.</p>

@if (_loading) { <LoadingIndicator Message="Cargando tus citas…" />; }
else if (_error is not null)
{
    <ErrorState Message="@_error" OnRetry="LoadAsync" />
}
else if (_items.Count == 0)
{
    <EmptyState Title="Sin citas activas" Description="Aún no tienes citas programadas.">
        <a class="btn btn-primary" href="/paciente/citas/nueva">Programar una cita</a>
    </EmptyState>;
}
else
{
    <ul class="task-list">
        @foreach (var item in _items)
        {
            <li>
                <article class="card">
                    <h2 class="card-title">@item.DoctorName</h2>
                    <p class="text-muted">@item.SpecialtyName</p>
                    <p class="meta-text">@item.AppointmentDateTime.ToLocalTime().ToString("f")</p>
                    <div class="appointment-card-meta">
                        <AppointmentStatusBadge Status="item.Status" />
                    </div>
                    <div class="hero-actions">
                        <a class="btn btn-secondary" href="/paciente/citas/@item.Id/reprogramar">Reprogramar</a>
                        <button class="btn btn-danger" type="button" @onclick="() => AskCancel(item)">Cancelar</button>
                    </div>
                </article>
            </li>
        }
    </ul>
}

<ConfirmDialog @bind-IsOpen="_confirmOpen" Title="Cancelar cita"
               Message="Esta acción cancelará la cita seleccionada. El horario quedará disponible para otros pacientes."
               ConfirmText="Sí, cancelar" OnConfirmed="CancelAsync" />

@code {
    private bool _loading = true;
    private string? _error;
    private List<Models.Appointments.AppointmentDto> _items = [];
    private bool _confirmOpen;
    private Guid? _cancelId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            await AuthReadiness.WaitForApiTokenAsync();
            _items = (await AppointmentApi.GetMyAppointmentsAsync()).ToList();
        }
        catch (ApiException ex) { _error = ApiErrorTranslator.ToUserMessage(ex); }
        finally { _loading = false; }
    }

    private void AskCancel(Models.Appointments.AppointmentDto item)
    {
        _cancelId = item.Id;
        _confirmOpen = true;
    }

    private async Task CancelAsync()
    {
        if (_cancelId is null) return;
        try
        {
            await AppointmentApi.CancelAsync(_cancelId.Value);
            await LoadAsync();
        }
        catch (ApiException ex) { _error = ApiErrorTranslator.ToUserMessage(ex); }
    }
}
