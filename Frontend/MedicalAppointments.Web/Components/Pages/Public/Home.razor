@page "/"
@layout PublicLayout

<section class="hero">
    <div>
        <h1 class="page-title">Sistema de Gestión de Citas de Especialidades Médicas</h1>
        <p class="page-lead">
            Agenda consultas con especialistas de forma clara, segura y centrada en tu experiencia como paciente.
        </p>
        <div class="hero-actions">
            <a class="btn btn-primary" href="/registro">Agendar una cita</a>
            <a class="btn btn-secondary" href="/login">Iniciar sesión</a>
        </div>
    </div>
    <div class="benefits" aria-label="Beneficios del sistema">
        <article class="card benefit-card">
            <span class="benefit-icon" aria-hidden="true">1</span>
            <div>
                <h2 class="card-title">Consulta especialidades</h2>
                <p class="text-muted">Explora las áreas médicas disponibles antes de elegir.</p>
            </div>
        </article>
        <article class="card benefit-card">
            <span class="benefit-icon" aria-hidden="true">2</span>
            <div>
                <h2 class="card-title">Elige especialista</h2>
                <p class="text-muted">Selecciona al profesional que prefieras.</p>
            </div>
        </article>
        <article class="card benefit-card">
            <span class="benefit-icon" aria-hidden="true">3</span>
            <div>
                <h2 class="card-title">Agenda fácilmente</h2>
                <p class="text-muted">Un flujo guiado paso a paso hasta confirmar tu cita.</p>
            </div>
        </article>
        <article class="card benefit-card">
            <span class="benefit-icon" aria-hidden="true">4</span>
            <div>
                <h2 class="card-title">Consulta tus citas</h2>
                <p class="text-muted">Revisa, reprograma o cancela cuando lo necesites.</p>
            </div>
        </article>
    </div>
</section>
