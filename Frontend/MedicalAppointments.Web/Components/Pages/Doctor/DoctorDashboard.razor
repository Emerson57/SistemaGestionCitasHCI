@page "/medico"
@attribute [Authorize(Roles = AppRoles.Doctor)]
@rendermode InteractiveServer
@inject IDoctorApiService DoctorApi

<PageTitle>Panel del médico</PageTitle>
<h1 class="page-title">Panel del médico</h1>
<p class="page-lead">Revisa tu agenda y mantén tu disponibilidad actualizada.</p>

@if (_loading) { <LoadingIndicator />; }
else
{
    <div class="grid-cards" style="margin-bottom: var(--space-lg);">
        <article class="card">
            <h2 class="card-title">Hoy</h2>
            <p class="meta-text">@_todayCount citas programadas para hoy</p>
        </article>
        <article class="card">
            <h2 class="card-title">Próximas</h2>
            <p class="meta-text">@_upcomingCount citas futuras en tu agenda</p>
        </article>
    </div>
    <div class="dashboard-actions">
        <a class="btn btn-primary" href="/medico/agenda">Ver agenda</a>
        <a class="btn btn-secondary" href="/medico/disponibilidad">Gestionar disponibilidad</a>
    </div>
}

@code {
    private bool _loading = true;
    private int _todayCount;
    private int _upcomingCount;

    protected override async Task OnInitializedAsync()
    {
        var agenda = await DoctorApi.GetMyAgendaAsync();
        var today = DateOnly.FromDateTime(DateTime.Today);
        _todayCount = agenda.Count(a => DateOnly.FromDateTime(a.AppointmentDateTime.LocalDateTime) == today);
        _upcomingCount = agenda.Count(a => a.AppointmentDateTime >= DateTimeOffset.Now);
        _loading = false;
    }
}
