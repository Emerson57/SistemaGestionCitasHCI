@page "/login"
@layout PublicLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inject IAuthApiService AuthApi
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión</PageTitle>
<h1 class="page-title">Iniciar sesión</h1>

@if (_sessionExpired)
{
    <div class="validation-summary" role="alert">Tu sesión ha expirado. Inicia sesión nuevamente.</div>
}

<EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="loginForm">
    <DataAnnotationsValidator />
    <ValidationSummary class="validation-summary" />

    <div class="form-field">
        <label for="email">Correo electrónico</label>
        <InputText id="email" @bind-Value="_model.Email" autocomplete="username" />
        <ValidationMessage For="() => _model.Email" class="field-error" />
    </div>

    <div class="form-field">
        <label for="password">Contraseña</label>
        <InputText id="password" type="@(_showPassword ? "text" : "password")" @bind-Value="_model.Password" autocomplete="current-password" />
        <button type="button" class="btn btn-secondary" @onclick="() => _showPassword = !_showPassword">@(_showPassword ? "Ocultar" : "Mostrar")</button>
        <ValidationMessage For="() => _model.Password" class="field-error" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="validation-summary" role="alert">@_error</div>
    }

    <button class="btn btn-primary" type="submit" disabled="@_loading">@(_loading ? "Ingresando…" : "Iniciar sesión")</button>
</EditForm>

@code {
    private readonly LoginFormModel _model = new();
    private bool _loading;
    private bool _showPassword;
    private string? _error;
    private bool _sessionExpired;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "expired")]
    public string? Expired { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _sessionExpired = Expired == "1";
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(GetDashboardForRole(state.User), replace: true);
        }
    }

    private async Task SubmitAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var response = await AuthApi.LoginAsync(new Models.Authentication.LoginRequest
            {
                Email = _model.Email.Trim(),
                Password = _model.Password
            });
            await AuthProvider.SignInAsync(response);
            Navigation.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? GetDashboardForRole(JwtAuthenticationStateProvider.CreatePrincipal(response)) : ReturnUrl, forceLoad: true);
        }
        catch (ApiException ex) when (ex.StatusCode is 401 or 400)
        {
            _error = ApiErrorTranslator.LoginFailureMessage();
        }
        catch (ApiException ex)
        {
            _error = ApiErrorTranslator.ToUserMessage(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetDashboardForRole(System.Security.Claims.ClaimsPrincipal user) =>
        user.IsInRole(AppRoles.Administrator) ? "/admin"
        : user.IsInRole(AppRoles.Doctor) ? "/medico"
        : "/paciente";

    private sealed class LoginFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El correo es obligatorio.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Ingresa un correo válido.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Password { get; set; } = string.Empty;
    }
}
