@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Saltar al contenido</a>
<div class="app-shell">
    <header class="app-header">
        <div>
            <div class="app-brand">Sistema de Citas Médicas</div>
            <AuthorizeView>
                <Authorized>
                    <div class="app-user">
                        <span class="text-secondary">@context.User.Identity?.Name</span>
                        @{
                            var role = context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                            if (!string.IsNullOrEmpty(role))
                            {
                                <span class="role-badge">@DisplayLabels.FormatRole(role)</span>
                            }
                        }
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
        <HeaderActions @bind-NavOpen="_navOpen" />
    </header>

    <aside id="app-sidebar" class="app-sidebar @(_navOpen ? "open" : string.Empty)">
        <AuthorizeView>
            <Authorized>
                @{
                    var navRole = context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
                }
                <RoleNav Role="@navRole" />
            </Authorized>
        </AuthorizeView>
    </aside>

    <main id="main-content" class="app-content">
        <div class="page-container">
            @Body
        </div>
    </main>
</div>
<ToastHost />

@code {
    private bool _navOpen;
}
